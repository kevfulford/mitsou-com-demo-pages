# ===== mitsou.com — static site (Apache, cPanel) =====
# Do NOT add "RewriteOptions Inherit" — this file must replace the parent's rewrite rules.

Options +FollowSymLinks -Indexes -MultiViews
DirectorySlash On
DirectoryIndex index.html

RewriteEngine On
RewriteBase /mitsou/

# Host lock: this folder is only ever served as mitsou.com.
# Prevents mitsoumagazine.com/mitsou/ from existing as duplicate content.
RewriteCond %{HTTP_HOST} !^(www\.)?mitsou\.com$ [NC]
RewriteRule ^ - [R=404,L]

# Clean URLs: /biographie -> biographie.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /mitsou/404.html

# ── Sécurité : ne jamais exposer le dépôt Git ni la documentation
# Motifs non ancrés : ils fonctionnent aussi quand le chemin interne
# est préfixé par le dossier du site (réécriture du .htaccess parent).
RedirectMatch 404 /\.git
RedirectMatch 404 /\.github
RedirectMatch 404 /\.gitignore$
RedirectMatch 404 \.md$
RedirectMatch 404 /(docs|scripts)(/|$)

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ── Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# ── Cache navigateur
# CSS et JS sont versionnés dans le HTML (?v=…) : on peut les garder longtemps.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 hour"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType video/mp4                 "access plus 1 month"
  ExpiresByType video/webm                "access plus 1 month"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# Correct MIME types (self-hosted webmanifest, fonts, images, video)
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType video/webm .webm
</IfModule>
# ===== end =====
